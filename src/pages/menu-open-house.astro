---
import Layout from '../layouts/Layout.astro';

const bebidas = [
  { nombre: 'Americano', precio: 65 },
  { nombre: 'Latte', precio: 75 },
  { nombre: 'Matcha', precio: 58 },
  { nombre: 'Tisana / Té', precio: 73 },
  { nombre: 'Agua Celis', precio: 45 },
];

const postres = [
  { nombre: 'Rebanada de panqué', precio: 65 },
  { nombre: 'Pastel individual', precio: 110 },
  { nombre: 'Galleta', precio: 45 },
];

const metodosPago = ['Efectivo', 'Transferencia', 'Tarjeta'];
---

<Layout
  title="Menú Open House — Mimo Estudio & Barra"
  description="Menú del Open House de Mimo Estudio & Barra, 27 y 28 de noviembre."
>
  <main class="menu-page">
    <div class="bg" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <img class="logo" src="/mimo-logo-blanco.png" alt="Mimo Estudio & Barra" />
      <p class="eyebrow">Open House</p>
      <h1 class="title">Menú</h1>

      <section class="menu-section">
        <h2>Bebidas</h2>
        {
          bebidas.map((item) => (
            <div class="menu-row one-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.precio}`}</span>
            </div>
          ))
        }
      </section>

      <section class="menu-section">
        <h2>Postres</h2>
        {
          postres.map((item) => (
            <div class="menu-row one-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.precio}`}</span>
            </div>
          ))
        }
      </section>

      <div class="payment">
        <p class="payment-title">Métodos de pago</p>
        <p class="payment-options">{metodosPago.join(' · ')}</p>
      </div>

      <div class="social">
        <p class="social-title">Síguenos en nuestras redes</p>
        <div class="social-links">
          <a href="https://www.facebook.com/mimoestudio.mx" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"
              />
            </svg>
          </a>
          <a href="https://www.instagram.com/mimoestudio.mx" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </div>
        <a class="review-link" href="https://g.page/r/CRNfmAWG6xMGECE/review" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="m12 2.6 2.74 6.24 6.79.62-5.13 4.51 1.54 6.63L12 17.02l-5.94 3.58 1.54-6.63-5.13-4.51 6.79-.62L12 2.6Z"
            />
          </svg>
          Déjanos tu opinión
        </a>
      </div>

      <img class="wave-illustration" src="/char-wave-white.png" alt="Mimo saludando" loading="lazy" />
    </div>
  </main>

  <style>
    .menu-page {
      position: relative;
      min-height: 100svh;
      display: flex;
      justify-content: center;
      overflow: hidden;
      padding: 48px 24px 0;
    }
    .bg {
      position: fixed;
      inset: -20px;
      z-index: -2;
      background: url('/menu-bg.jpg') center / cover no-repeat;
      filter: blur(16px) brightness(0.75);
      transform: scale(1.1);
    }
    .scrim {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        180deg,
        rgba(28, 30, 21, 0.78) 0%,
        rgba(28, 30, 21, 0.55) 25%,
        rgba(28, 30, 21, 0.72) 100%
      );
    }
    .content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .logo {
      height: 42px;
      width: auto;
      margin-bottom: 18px;
    }
    .eyebrow {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-mid);
      margin: 0 0 4px;
    }
    .title {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      font-size: clamp(3rem, 14vw, 4.5rem);
      color: #fff;
      margin: 0 0 36px;
      line-height: 0.95;
    }

    /* ---------- Menu list (no cards, just hairline rows) ---------- */
    .menu-section {
      width: 100%;
      margin-bottom: 30px;
    }
    .menu-section h2 {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      font-size: 1.4rem;
      color: var(--accent-mid);
      text-align: left;
      margin: 0 0 10px;
    }
    .menu-row {
      display: grid;
      align-items: baseline;
      padding: 13px 2px;
      border-bottom: 1px solid rgba(251, 249, 238, 0.14);
      font-family: 'Poppins', sans-serif;
      text-align: left;
    }
    .menu-row.one-col {
      grid-template-columns: 1fr auto;
    }
    .item-name {
      font-weight: 400;
      font-size: 1rem;
      color: var(--paper);
    }
    .item-price {
      font-weight: 600;
      font-size: 0.95rem;
      color: #fff;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    /* ---------- Payment methods ---------- */
    .payment {
      width: 100%;
      margin-top: 6px;
      padding-top: 24px;
      border-top: 1px solid rgba(251, 249, 238, 0.18);
      text-align: center;
    }
    .payment-title {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent-mid);
      margin: 0 0 6px;
    }
    .payment-options {
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      font-size: 0.95rem;
      color: var(--paper);
      margin: 0;
    }

    /* ---------- Social / review ---------- */
    .social {
      margin-top: 28px;
      width: 100%;
    }
    .social-title {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--accent-mid);
      margin: 0 0 16px;
    }
    .social-links {
      display: flex;
      gap: 18px;
      justify-content: center;
      margin-bottom: 22px;
    }
    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(251, 249, 238, 0.35);
      color: #fff;
      transition: all 0.2s ease;
    }
    .social-links svg {
      width: 20px;
      height: 20px;
    }
    .social-links a:hover {
      border-color: #fff;
      transform: translateY(-2px);
    }
    .review-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--accent-mid);
      text-decoration: underline;
      text-decoration-color: var(--accent-mid);
      text-decoration-thickness: 1.5px;
      text-underline-offset: 4px;
      transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }
    .review-link svg {
      width: 16px;
      height: 16px;
    }
    .review-link:hover {
      color: #fff;
      text-decoration-color: #fff;
    }

    /* ---------- Illustration ---------- */
    .wave-illustration {
      display: block;
      width: 190px;
      height: auto;
      margin: 24px 0 0;
      opacity: 0.95;
    }
  </style>
</Layout>
