---
import Layout from '../layouts/Layout.astro';

const bebidasCalientes = [
  { nombre: 'Americano', caliente: 45, frio: 55 },
  { nombre: 'Latte', caliente: 55, frio: 65 },
  { nombre: 'Matcha', caliente: 60, frio: 70 },
  { nombre: 'Chocolate', caliente: 55, frio: 65 },
  { nombre: 'Tisana / té', caliente: 45, frio: 50 },
];

const bebidasFrias = [
  { nombre: 'Agua Celis', precio: 25 },
  { nombre: 'Jugo verde', precio: 50 },
  { nombre: 'Jugo de naranja', precio: 45 },
];

const postres = [
  { nombre: 'Rebanada de panqué', precio: 40 },
  { nombre: 'Pastel', precio: 55 },
  { nombre: 'Galleta', precio: 30 },
];
---

<Layout
  title="Menú Open House — Mimo Estudio & Barra"
  description="Menú del Open House de Mimo Estudio & Barra, 27 y 28 de noviembre."
>
  <main class="menu-page">
    <div class="bg" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <img class="logo" src="/mimo-logo-blanco.png" alt="Mimo Estudio & Barra" />
      <p class="eyebrow">Open House</p>
      <h1 class="title">Menú</h1>

      <section class="menu-section">
        <h2>Bebidas calientes y frías</h2>
        <div class="menu-columns">
          <span></span>
          <span class="col-label">Caliente</span>
          <span class="col-label">Frío</span>
        </div>
        {
          bebidasCalientes.map((item) => (
            <div class="menu-row two-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.caliente}`}</span>
              <span class="item-price">{`$${item.frio}`}</span>
            </div>
          ))
        }
      </section>

      <section class="menu-section">
        <h2>Bebidas frías</h2>
        {
          bebidasFrias.map((item) => (
            <div class="menu-row one-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.precio}`}</span>
            </div>
          ))
        }
      </section>

      <section class="menu-section">
        <h2>Postres</h2>
        {
          postres.map((item) => (
            <div class="menu-row one-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.precio}`}</span>
            </div>
          ))
        }
      </section>

      <div class="social">
        <p class="social-title">Síguenos en nuestras redes</p>
        <div class="social-links">
          <a href="https://www.facebook.com/mimoestudio.mx" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"
              />
            </svg>
          </a>
          <a href="https://www.instagram.com/mimoestudio.mx" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.47.66.26 1.21.6 1.77 1.15.5.5.9 1.1 1.15 1.77.25.64.42 1.36.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.36.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.47-2.43.26-.66.6-1.21 1.15-1.77A4.9 4.9 0 0 1 5.45.53c.64-.25 1.36-.42 2.43-.47C8.94.01 9.28 0 12 0Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.25A3.25 3.25 0 1 1 12 6.75a3.25 3.25 0 0 1 0 6.5ZM17.4 4.6a1.17 1.17 0 1 0 0 2.34 1.17 1.17 0 0 0 0-2.34Z"
              />
            </svg>
          </a>
        </div>
        <a class="review-link" href="https://g.page/r/CRNfmAWG6xMGECE/review" target="_blank" rel="noopener">
          Déjanos tu opinión ★
        </a>
      </div>

      <img class="wave-illustration" src="/char-wave-white.png" alt="Mimo saludando" loading="lazy" />
    </div>
  </main>

  <style>
    .menu-page {
      position: relative;
      min-height: 100svh;
      display: flex;
      justify-content: center;
      overflow: hidden;
      padding: 48px 24px 32px;
    }
    .bg {
      position: fixed;
      inset: -20px;
      z-index: -2;
      background: url('/menu-bg.jpg') center / cover no-repeat;
      filter: blur(16px) brightness(0.75);
      transform: scale(1.1);
    }
    .scrim {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        180deg,
        rgba(28, 30, 21, 0.78) 0%,
        rgba(28, 30, 21, 0.55) 25%,
        rgba(28, 30, 21, 0.72) 100%
      );
    }
    .content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .logo {
      height: 42px;
      width: auto;
      margin-bottom: 18px;
    }
    .eyebrow {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-mid);
      margin: 0 0 4px;
    }
    .title {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      font-size: clamp(3rem, 14vw, 4.5rem);
      color: #fff;
      margin: 0 0 36px;
      line-height: 0.95;
    }

    /* ---------- Menu list (no cards, just hairline rows) ---------- */
    .menu-section {
      width: 100%;
      margin-bottom: 30px;
    }
    .menu-section h2 {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      font-size: 1.4rem;
      color: var(--accent-mid);
      text-align: left;
      margin: 0 0 10px;
    }
    .menu-columns {
      display: grid;
      grid-template-columns: 1fr 64px 64px;
      padding: 0 2px 6px;
    }
    .col-label {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.78rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--accent-mid);
      text-align: right;
    }
    .menu-row {
      display: grid;
      align-items: baseline;
      padding: 13px 2px;
      border-bottom: 1px solid rgba(251, 249, 238, 0.14);
      font-family: 'Poppins', sans-serif;
      text-align: left;
    }
    .menu-row.two-col {
      grid-template-columns: 1fr 64px 64px;
    }
    .menu-row.one-col {
      grid-template-columns: 1fr auto;
    }
    .item-name {
      font-weight: 400;
      font-size: 1rem;
      color: var(--paper);
    }
    .item-price {
      font-weight: 600;
      font-size: 0.95rem;
      color: #fff;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    /* ---------- Social / review ---------- */
    .social {
      margin-top: 6px;
      padding-top: 28px;
      border-top: 1px solid rgba(251, 249, 238, 0.18);
      width: 100%;
    }
    .social-title {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--accent-mid);
      margin: 0 0 16px;
    }
    .social-links {
      display: flex;
      gap: 18px;
      justify-content: center;
      margin-bottom: 22px;
    }
    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(251, 249, 238, 0.35);
      color: #fff;
      transition: all 0.2s ease;
    }
    .social-links svg {
      width: 20px;
      height: 20px;
    }
    .social-links a:hover {
      border-color: #fff;
      transform: translateY(-2px);
    }
    .review-link {
      display: inline-block;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      color: #20230f;
      background: var(--accent-mid);
      padding: 13px 28px;
      border-radius: 100px;
      box-shadow: 0 6px 0 0 var(--accent-strong);
      transition: transform 0.15s ease;
    }
    .review-link:hover {
      transform: translateY(-2px);
    }
    .review-link:active {
      transform: translateY(3px);
      box-shadow: 0 3px 0 0 var(--accent-strong);
    }

    /* ---------- Illustration ---------- */
    .wave-illustration {
      width: 150px;
      height: auto;
      margin-top: 32px;
      opacity: 0.95;
    }
  </style>
</Layout>
