---
import Layout from '../layouts/Layout.astro';

const bebidasCalientes = [
  { nombre: 'Americano', caliente: 45, frio: 55 },
  { nombre: 'Latte', caliente: 55, frio: 65 },
  { nombre: 'Matcha', caliente: 60, frio: 70 },
  { nombre: 'Chocolate', caliente: 55, frio: 65 },
  { nombre: 'Tisana / té', caliente: 45, frio: 50 },
];

const bebidasFrias = [
  { nombre: 'Agua Celis', precio: 25 },
  { nombre: 'Jugo verde', precio: 50 },
  { nombre: 'Jugo de naranja', precio: 45 },
];

const postres = [
  { nombre: 'Rebanada de panqué', precio: 40 },
  { nombre: 'Pastel', precio: 55 },
  { nombre: 'Galleta', precio: 30 },
];
---

<Layout
  title="Menú Open House — Mimo Estudio & Barra"
  description="Menú del Open House de Mimo Estudio & Barra, 27 y 28 de noviembre."
>
  <main class="menu-page">
    <div class="bg" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <img class="logo" src="/mimo-logo-blanco.png" alt="Mimo Estudio & Barra" />
      <p class="eyebrow">Open House</p>
      <h1 class="title">Menú</h1>

      <nav class="tabs" id="menu-tabs">
        <button class="tab-btn active" type="button" data-target="panel-calientes">Bebidas</button>
        <button class="tab-btn" type="button" data-target="panel-frias">Frías</button>
        <button class="tab-btn" type="button" data-target="panel-postres">Postres</button>
      </nav>

      <section class="menu-panel" id="panel-calientes">
        <div class="menu-columns">
          <span></span>
          <span class="col-label">Caliente</span>
          <span class="col-label">Frío</span>
        </div>
        {
          bebidasCalientes.map((item) => (
            <div class="menu-row two-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.caliente}`}</span>
              <span class="item-price">{`$${item.frio}`}</span>
            </div>
          ))
        }
      </section>

      <section class="menu-panel" id="panel-frias" hidden>
        {
          bebidasFrias.map((item) => (
            <div class="menu-row one-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.precio}`}</span>
            </div>
          ))
        }
      </section>

      <section class="menu-panel" id="panel-postres" hidden>
        {
          postres.map((item) => (
            <div class="menu-row one-col">
              <span class="item-name">{item.nombre}</span>
              <span class="item-price">{`$${item.precio}`}</span>
            </div>
          ))
        }
      </section>

      <div class="social">
        <p class="social-title">Síguenos en nuestras redes</p>
        <div class="social-links">
          <a href="https://www.facebook.com/mimoestudio.mx" target="_blank" rel="noopener">Facebook</a>
          <a href="https://www.instagram.com/mimoestudio.mx" target="_blank" rel="noopener">Instagram</a>
        </div>
        <a class="review-link" href="https://g.page/r/CRNfmAWG6xMGECE/review" target="_blank" rel="noopener">
          Déjanos tu opinión ★
        </a>
      </div>
    </div>
  </main>

  <style>
    .menu-page {
      position: relative;
      min-height: 100svh;
      display: flex;
      justify-content: center;
      overflow: hidden;
      padding: 48px 24px 56px;
    }
    .bg {
      position: fixed;
      inset: -20px;
      z-index: -2;
      background: url('/menu-bg.jpg') center / cover no-repeat;
      filter: blur(16px) brightness(0.75);
      transform: scale(1.1);
    }
    .scrim {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        180deg,
        rgba(28, 30, 21, 0.78) 0%,
        rgba(28, 30, 21, 0.55) 25%,
        rgba(28, 30, 21, 0.72) 100%
      );
    }
    .content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .logo {
      height: 42px;
      width: auto;
      margin-bottom: 18px;
    }
    .eyebrow {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-mid);
      margin: 0 0 4px;
    }
    .title {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      font-size: clamp(3rem, 14vw, 4.5rem);
      color: #fff;
      margin: 0 0 24px;
      line-height: 0.95;
    }

    /* ---------- Tabs ---------- */
    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 28px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .tab-btn {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--paper);
      background: transparent;
      border: 1px solid rgba(251, 249, 238, 0.35);
      border-radius: 100px;
      padding: 9px 20px;
      transition: all 0.2s ease;
    }
    .tab-btn.active {
      background: var(--accent-mid);
      border-color: var(--accent-mid);
      color: #20230f;
    }
    .tab-btn:not(.active):hover {
      border-color: rgba(251, 249, 238, 0.7);
    }

    /* ---------- Menu list (no cards, just hairline rows) ---------- */
    .menu-panel {
      width: 100%;
      margin-bottom: 8px;
      animation: fade-in 0.25s ease;
    }
    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .menu-columns {
      display: grid;
      grid-template-columns: 1fr 64px 64px;
      padding: 0 2px 6px;
    }
    .col-label {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.78rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--accent-mid);
      text-align: right;
    }
    .menu-row {
      display: grid;
      align-items: baseline;
      padding: 13px 2px;
      border-bottom: 1px solid rgba(251, 249, 238, 0.14);
      font-family: 'Poppins', sans-serif;
      text-align: left;
    }
    .menu-row.two-col {
      grid-template-columns: 1fr 64px 64px;
    }
    .menu-row.one-col {
      grid-template-columns: 1fr auto;
    }
    .item-name {
      font-weight: 400;
      font-size: 1rem;
      color: var(--paper);
    }
    .item-price {
      font-weight: 600;
      font-size: 0.95rem;
      color: #fff;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    /* ---------- Social / review ---------- */
    .social {
      margin-top: 36px;
      padding-top: 28px;
      border-top: 1px solid rgba(251, 249, 238, 0.18);
      width: 100%;
    }
    .social-title {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--accent-mid);
      margin: 0 0 14px;
    }
    .social-links {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }
    .social-links a {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      color: #fff;
      border: 1px solid rgba(251, 249, 238, 0.35);
      border-radius: 100px;
      padding: 10px 22px;
      transition: all 0.2s ease;
    }
    .social-links a:hover {
      border-color: #fff;
      transform: translateY(-1px);
    }
    .review-link {
      display: inline-block;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      color: #20230f;
      background: var(--accent-mid);
      padding: 13px 28px;
      border-radius: 100px;
      box-shadow: 0 6px 0 0 var(--accent-strong);
      transition: transform 0.15s ease;
    }
    .review-link:hover {
      transform: translateY(-2px);
    }
    .review-link:active {
      transform: translateY(3px);
      box-shadow: 0 3px 0 0 var(--accent-strong);
    }
  </style>

  <script>
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.menu-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const targetId = btn.dataset.target;
        panels.forEach((panel) => {
          panel.hidden = panel.id !== targetId;
        });
      });
    });
  </script>
</Layout>
