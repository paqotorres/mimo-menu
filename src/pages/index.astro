---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Open House — Mimo Estudio & Barra">
  <main class="hero">
    <div class="bg" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="content">
      <img class="logo" src="/mimo-logo-blanco.png" alt="Mimo Estudio & Barra" />

      <p class="eyebrow">Te invitamos a conocer nuestro estudio</p>
      <h1 class="title">
        <span>OPEN</span>
        <span>HOUSE</span>
      </h1>
      <p class="dates">27 y 28 de noviembre 2026</p>

      <div class="schedule">
        <div class="day">
          <span class="day-name">Viernes 27</span>
          <span class="day-time">9:00 am – 2:00 pm &nbsp;y&nbsp; 4:00 pm – 8:00 pm</span>
        </div>
        <div class="day">
          <span class="day-name">Sábado 28</span>
          <span class="day-time">9:00 am – 12:00 pm</span>
        </div>
      </div>

      <div class="countdown" id="countdown" aria-live="polite">
        <div class="unit"><span class="num" id="cd-days">00</span><span class="label">días</span></div>
        <div class="unit"><span class="num" id="cd-hours">00</span><span class="label">hrs</span></div>
        <div class="unit"><span class="num" id="cd-mins">00</span><span class="label">min</span></div>
        <div class="unit"><span class="num" id="cd-secs">00</span><span class="label">seg</span></div>
      </div>

      <button class="cta" id="open-registro" type="button">Registro gratuito</button>
    </div>
  </main>

  <!-- ===================== Modal de registro ===================== -->
  <div class="modal-backdrop" id="modal-backdrop" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button class="modal-close" id="modal-close" type="button" aria-label="Cerrar">&times;</button>

      <!-- Paso 1: datos -->
      <section class="step" id="step-1">
        <p class="step-count">Paso 1 de 2</p>
        <h2 id="modal-title">Regístrate al Open House</h2>
        <p class="step-sub">Déjanos tus datos para apartar tu lugar.</p>
        <label class="field">
          <span>Nombre *</span>
          <input type="text" id="f-nombre" autocomplete="name" placeholder="Tu nombre completo" required />
        </label>
        <label class="field">
          <span>Número de celular *</span>
          <input type="tel" id="f-telefono" autocomplete="tel" placeholder="871 000 0000" required />
        </label>
        <p class="field-error" id="step1-error" hidden>Completa tu nombre y celular para continuar.</p>
        <button class="btn-primary" id="to-step-2" type="button">Siguiente →</button>
      </section>

      <!-- Paso 2: horario -->
      <section class="step" id="step-2" hidden>
        <p class="step-count">Paso 2 de 2</p>
        <h2>¿Qué día y hora te gustaría venir?</h2>
        <p class="step-sub">Primero elige el día y después tu hora de llegada.</p>
        <div class="day-select" id="day-select">
          <button class="day-btn" type="button" data-day="2026-11-27">Viernes 27</button>
          <button class="day-btn" type="button" data-day="2026-11-28">Sábado 28</button>
        </div>
        <div class="slots" id="slots"></div>
        <p class="field-error" id="step2-error" hidden>Elige un horario para continuar.</p>
        <div class="step-actions">
          <button class="btn-ghost" id="back-step-1" type="button">← Atrás</button>
          <button class="btn-primary" id="submit-registro" type="button">Enviar registro</button>
        </div>
        <p class="whatsapp-note">Tu lugar quedará registrado automáticamente, sin salir de esta página.</p>
      </section>

      <!-- Paso 3: confirmación -->
      <section class="step" id="step-3" hidden>
        <div class="confirm-head">
          <h2>¡Listo, <span id="confirm-name">!</span> 🎉</h2>
          <p id="confirm-slot" class="step-sub"></p>
        </div>

        <div class="map-wrap">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3597.5607333398707!2d-103.39486448889134!3d25.619508914371654!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x868fd1488765cf9d%3A0x613eb8605985f13!2sMimo%20Estudio%20%26%20Barra!5e0!3m2!1ses!2smx!4v1788617074953!5m2!1ses!2smx"
            title="Ubicación de Mimo Estudio & Barra"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <p class="address">Carretera a San Pedro 8500 Interior 6, Torreón, Coah.</p>

        <p class="cal-label">Agrega el recordatorio a tu calendario:</p>
        <div class="cal-buttons">
          <a class="cal-btn" id="cal-google" href="#" target="_blank" rel="noopener">Google Calendar</a>
          <a class="cal-btn" id="cal-outlook" href="#" target="_blank" rel="noopener">Outlook</a>
          <a class="cal-btn" id="cal-apple" href="#" download="mimo-open-house.ics">Apple / iOS</a>
        </div>

        <button class="btn-ghost" id="close-step-3" type="button">Cerrar</button>
      </section>
    </div>
  </div>

  <style is:global>
    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 48px 24px;
    }
    .bg {
      position: absolute;
      inset: 0;
      background: url('/openhouse-bg.jpg') center / cover no-repeat;
    }
    .scrim {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(28, 30, 21, 0.45) 0%, rgba(28, 30, 21, 0.72) 100%);
    }
    .content {
      position: relative;
      z-index: 1;
      max-width: 720px;
      width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .logo {
      height: 54px;
      width: auto;
      margin-bottom: 28px;
    }
    .eyebrow {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-mid);
      margin: 0 0 6px;
    }
    h1.title {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      margin: 0;
      line-height: 0.92;
      color: #fff;
      display: flex;
      flex-direction: column;
      letter-spacing: 0.01em;
    }
    h1.title span {
      font-size: clamp(3.2rem, 13vw, 7.5rem);
    }
    .dates {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: clamp(1.1rem, 2.6vw, 1.5rem);
      color: var(--on-accent);
      margin: 18px 0 28px;
    }
    .schedule {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin-bottom: 34px;
    }
    .day {
      background: rgba(251, 249, 238, 0.1);
      border: 1px solid rgba(251, 249, 238, 0.25);
      border-radius: 14px;
      padding: 12px 20px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 220px;
    }
    .day-name {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
    }
    .day-time {
      font-family: 'Poppins', sans-serif;
      font-weight: 400;
      font-size: 0.85rem;
      color: rgba(251, 249, 238, 0.85);
    }
    .countdown {
      display: flex;
      gap: 12px;
      margin-bottom: 34px;
    }
    .unit {
      background: rgba(0, 0, 0, 0.28);
      border: 1px solid rgba(251, 249, 238, 0.2);
      border-radius: 12px;
      padding: 10px 14px;
      min-width: 64px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .unit .num {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: clamp(1.4rem, 4vw, 1.9rem);
      color: #fff;
      font-variant-numeric: tabular-nums;
    }
    .unit .label {
      font-family: 'Poppins', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-mid);
    }
    .cta {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      background: var(--accent-mid);
      color: #20230f;
      border: none;
      padding: 16px 40px;
      border-radius: 100px;
      box-shadow: 0 10px 0 0 var(--accent-strong);
      transition: transform 0.15s ease;
    }
    .cta:hover {
      transform: translateY(-2px);
    }
    .cta:active {
      transform: translateY(4px);
      box-shadow: 0 4px 0 0 var(--accent-strong);
    }

    /* ---------- Modal ---------- */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(10, 11, 7, 0.72);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 50;
    }
    .modal {
      position: relative;
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      overflow-y: auto;
      background: var(--paper);
      color: var(--ink);
      border-radius: 20px;
      padding: 36px 30px 30px;
    }
    .modal-close {
      position: absolute;
      top: 14px;
      right: 16px;
      background: none;
      border: none;
      font-size: 1.6rem;
      line-height: 1;
      color: var(--ink);
      opacity: 0.6;
    }
    .modal-close:hover {
      opacity: 1;
    }
    .step-count {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 6px;
    }
    .modal h2 {
      font-family: 'FreightMacro', Georgia, serif;
      font-weight: 700;
      font-size: 1.7rem;
      margin: 0 0 6px;
      line-height: 1.1;
    }
    .step-sub {
      font-family: 'Poppins', sans-serif;
      font-size: 0.92rem;
      color: #5b5f45;
      margin: 0 0 22px;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
      text-align: left;
    }
    .field span {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.82rem;
      color: var(--accent-strong);
    }
    .field input {
      font-family: 'Poppins', sans-serif;
      font-size: 1rem;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1.5px solid #D9D4BC;
      background: #fff;
      color: var(--ink);
    }
    .field input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .field input.invalid {
      border-color: #a3402c;
    }
    .field-error {
      font-family: 'Poppins', sans-serif;
      font-size: 0.82rem;
      color: #a3402c;
      margin: -6px 0 14px;
    }
    .btn-primary {
      width: 100%;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      background: var(--accent);
      color: var(--on-accent);
      border: none;
      padding: 14px;
      border-radius: 10px;
      margin-top: 6px;
    }
    .btn-primary:hover {
      background: var(--accent-strong);
    }
    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .btn-ghost {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      background: none;
      border: none;
      color: var(--accent-strong);
      padding: 10px;
    }
    .step-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 4px;
    }
    .step-actions .btn-primary {
      width: auto;
      flex: 1;
    }
    .whatsapp-note {
      font-family: 'Poppins', sans-serif;
      font-size: 0.78rem;
      color: #5b5f45;
      text-align: center;
      margin: 10px 0 0;
    }

    .day-select {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 18px;
    }
    .day-btn {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      background: #fff;
      border: 1.5px solid #D9D4BC;
      color: var(--ink);
      padding: 14px 10px;
      border-radius: 10px;
      text-align: center;
    }
    .day-btn:hover {
      border-color: var(--accent);
    }
    .day-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }
    .slots {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 18px;
    }
    .slot-group-label {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--accent-strong);
      margin-bottom: 8px;
      display: block;
    }
    .slot-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .slot-btn {
      font-family: 'Poppins', sans-serif;
      font-weight: 500;
      font-size: 0.8rem;
      background: #fff;
      border: 1.5px solid #D9D4BC;
      color: var(--ink);
      padding: 10px 6px;
      border-radius: 10px;
      text-align: center;
    }
    .slot-btn:hover {
      border-color: var(--accent);
    }
    .slot-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }

    .confirm-head h2 {
      font-size: 1.6rem;
    }
    .map-wrap {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #D9D4BC;
      margin-bottom: 8px;
    }
    .map-wrap iframe {
      width: 100%;
      height: 220px;
      border: 0;
      display: block;
    }
    .address {
      font-family: 'Poppins', sans-serif;
      font-size: 0.82rem;
      color: #5b5f45;
      margin: 0 0 22px;
    }
    .cal-label {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--accent-strong);
      margin: 0 0 10px;
    }
    .cal-buttons {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 18px;
    }
    .cal-btn {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      text-align: center;
      background: #fff;
      border: 1.5px solid #D9D4BC;
      color: var(--ink);
      padding: 12px;
      border-radius: 10px;
    }
    .cal-btn:hover {
      border-color: var(--accent);
    }
    #close-step-3 {
      width: 100%;
      text-align: center;
      background: var(--accent);
      color: var(--on-accent);
      border-radius: 10px;
    }
    #close-step-3:hover {
      background: var(--accent-strong);
    }

    @media (max-width: 480px) {
      .slot-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .schedule {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>

  <script>
    // ---------- Countdown ----------
    const TARGET = new Date('2026-11-27T09:00:00-06:00').getTime();
    function tickCountdown() {
      const diff = Math.max(0, TARGET - Date.now());
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const mins = Math.floor((diff % 3600000) / 60000);
      const secs = Math.floor((diff % 60000) / 1000);
      const pad = (n: number) => String(n).padStart(2, '0');
      const set = (id: string, v: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = v;
      };
      set('cd-days', pad(days));
      set('cd-hours', pad(hours));
      set('cd-mins', pad(mins));
      set('cd-secs', pad(secs));
    }
    tickCountdown();
    setInterval(tickCountdown, 1000);

    // ---------- Time slots (day first, then arrival time) ----------
    type Selected = { day: string; dayLabel: string; hour: number };

    function formatHour(h: number) {
      const ampm = h < 12 || h === 24 ? 'am' : 'pm';
      let h12 = h % 12;
      if (h12 === 0) h12 = 12;
      return `${h12}:00 ${ampm}`;
    }

    const days: { dayId: string; dateLabel: string; periods: { label: string; hours: number[] }[] }[] = [
      {
        dayId: '2026-11-27',
        dateLabel: 'viernes 27 de noviembre',
        periods: [
          { label: 'Mañana', hours: [9, 10, 11, 12, 13] },
          { label: 'Tarde', hours: [16, 17, 18, 19] },
        ],
      },
      {
        dayId: '2026-11-28',
        dateLabel: 'sábado 28 de noviembre',
        periods: [{ label: '', hours: [9, 10, 11] }],
      },
    ];

    const slotsContainer = document.getElementById('slots');
    let selectedSlot: Selected | null = null;

    function renderSlots(dayId: string) {
      if (!slotsContainer) return;
      slotsContainer.innerHTML = '';
      const day = days.find((d) => d.dayId === dayId);
      if (!day) return;
      day.periods.forEach((period) => {
        const wrap = document.createElement('div');
        if (period.label) {
          const label = document.createElement('span');
          label.className = 'slot-group-label';
          label.textContent = period.label;
          wrap.appendChild(label);
        }
        const grid = document.createElement('div');
        grid.className = 'slot-grid';
        period.hours.forEach((hour) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'slot-btn';
          btn.textContent = formatHour(hour);
          btn.addEventListener('click', () => {
            document.querySelectorAll('.slot-btn').forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            selectedSlot = { day: day.dayId, dayLabel: day.dateLabel, hour };
            hide('step2-error');
          });
          grid.appendChild(btn);
        });
        wrap.appendChild(grid);
        slotsContainer.appendChild(wrap);
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.day-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.day-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        selectedSlot = null;
        hide('step2-error');
        renderSlots(btn.dataset.day!);
      });
    });

    // ---------- Modal plumbing ----------
    function show(id: string) {
      document.getElementById(id)?.removeAttribute('hidden');
    }
    function hide(id: string) {
      document.getElementById(id)?.setAttribute('hidden', '');
    }

    const backdrop = document.getElementById('modal-backdrop');
    document.getElementById('open-registro')?.addEventListener('click', () => {
      backdrop?.removeAttribute('hidden');
      show('step-1');
      hide('step-2');
      hide('step-3');
      document.querySelectorAll('.day-btn').forEach((b) => b.classList.remove('active'));
      if (slotsContainer) slotsContainer.innerHTML = '';
      selectedSlot = null;
      (document.getElementById('f-nombre') as HTMLInputElement)?.classList.remove('invalid');
      (document.getElementById('f-telefono') as HTMLInputElement)?.classList.remove('invalid');
      hide('step1-error');
    });
    function closeModal() {
      backdrop?.setAttribute('hidden', '');
    }
    document.getElementById('modal-close')?.addEventListener('click', closeModal);
    document.getElementById('close-step-3')?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    const nombreInput = document.getElementById('f-nombre') as HTMLInputElement;
    const telefonoInput = document.getElementById('f-telefono') as HTMLInputElement;
    const step1ErrorEl = document.getElementById('step1-error');

    nombreInput?.addEventListener('input', () => nombreInput.classList.remove('invalid'));
    telefonoInput?.addEventListener('input', () => telefonoInput.classList.remove('invalid'));

    document.getElementById('to-step-2')?.addEventListener('click', () => {
      const nombre = nombreInput.value.trim();
      const telefonoDigits = telefonoInput.value.replace(/\D/g, '');
      const nombreValido = nombre.length >= 3;
      const telefonoValido = telefonoDigits.length >= 10;

      nombreInput.classList.toggle('invalid', !nombreValido);
      telefonoInput.classList.toggle('invalid', !telefonoValido);

      if (!nombreValido || !telefonoValido) {
        if (step1ErrorEl) {
          step1ErrorEl.textContent = !nombreValido && !telefonoValido
            ? 'Escribe tu nombre completo y un celular válido a 10 dígitos.'
            : !nombreValido
            ? 'Escribe tu nombre completo.'
            : 'Escribe un celular válido a 10 dígitos.';
        }
        show('step1-error');
        return;
      }
      hide('step1-error');
      hide('step-1');
      show('step-2');
    });

    document.getElementById('back-step-1')?.addEventListener('click', () => {
      hide('step-2');
      show('step-1');
    });

    // Log the registration as a row in a Google Sheet. Fire-and-forget: uses
    // no-cors + text/plain to dodge a CORS preflight against Apps Script, so
    // the response isn't readable, but Apps Script still appends the row.
    const SHEET_WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbzF2uCibQpN5_XKZv1jlJXve4jlmFSG23vwnstO0sceJPav7uCNCWlkYaPV7254Vo_D/exec';
    function notifyBySheet(nombre: string, telefono: string, dia: string, hora: string, fechaISO: string, horaNum: number) {
      try {
        fetch(SHEET_WEBHOOK_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ nombre, telefono, dia, hora, fechaISO, horaNum }),
        }).catch(() => {});
      } catch (e) {}
    }

    // Best-effort silent copy to the business inboxes. Never blocks or fails the
    // flow for the visitor — the Google Sheet (above) is the reliable record.
    function notifyByEmail(nombre: string, telefono: string, horarioTexto: string) {
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 4000);
        fetch('https://formsubmit.co/ajax/myrnavelazquez@mimoestudio.mx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          signal: controller.signal,
          body: JSON.stringify({
            Nombre: nombre,
            Teléfono: telefono,
            Horario: horarioTexto,
            _subject: 'Nuevo registro — Open House Mimo',
            _cc: 'alebourguet@mimoestudio.mx,paqotorres@hotmail.com',
            _template: 'table',
          }),
        })
          .catch(() => {})
          .finally(() => clearTimeout(timeout));
      } catch (e) {}
    }

    document.getElementById('submit-registro')?.addEventListener('click', () => {
      if (!selectedSlot) {
        show('step2-error');
        return;
      }
      hide('step2-error');

      const nombre = (document.getElementById('f-nombre') as HTMLInputElement).value.trim();
      const telefono = (document.getElementById('f-telefono') as HTMLInputElement).value.trim();
      const horarioTexto = `${selectedSlot.dayLabel}, ${formatHour(selectedSlot.hour)}`;

      // 1) Log the registration in the Google Sheet, fire-and-forget.
      notifyBySheet(nombre, telefono, selectedSlot.dayLabel, formatHour(selectedSlot.hour), selectedSlot.day, selectedSlot.hour);

      // 2) Best-effort bonus copy by email, fire-and-forget.
      notifyByEmail(nombre, telefono, horarioTexto);

      // ---- build confirmation screen ----
      const nameEl = document.getElementById('confirm-name');
      if (nameEl) nameEl.textContent = nombre;
      const slotEl = document.getElementById('confirm-slot');
      if (slotEl) slotEl.textContent = `Te esperamos el ${horarioTexto}.`;

      const startDate = new Date(`${selectedSlot.day}T${String(selectedSlot.hour).padStart(2, '0')}:00:00-06:00`);
      const endDate = new Date(startDate.getTime() + 60 * 60 * 1000);
      const fmtUTC = (d: Date) => d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      const location = 'Carretera a San Pedro 8500 Interior 6, Torreón, Coah.';
      const title = 'Open House — Mimo Estudio & Barra';
      const details = 'Te esperamos en Mimo Estudio & Barra para conocer el espacio.';

      const gcal = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${fmtUTC(startDate)}/${fmtUTC(endDate)}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(location)}`;
      (document.getElementById('cal-google') as HTMLAnchorElement).href = gcal;

      const outlook = `https://outlook.live.com/calendar/0/deeplink/compose?subject=${encodeURIComponent(title)}&startdt=${startDate.toISOString()}&enddt=${endDate.toISOString()}&location=${encodeURIComponent(location)}&body=${encodeURIComponent(details)}&path=/calendar/action/compose&rru=addevent`;
      (document.getElementById('cal-outlook') as HTMLAnchorElement).href = outlook;

      const ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Mimo Estudio & Barra//Open House//ES',
        'BEGIN:VEVENT',
        `UID:${Date.now()}@mimoestudio.mx`,
        `DTSTAMP:${fmtUTC(new Date())}`,
        `DTSTART:${fmtUTC(startDate)}`,
        `DTEND:${fmtUTC(endDate)}`,
        `SUMMARY:${title}`,
        `DESCRIPTION:${details}`,
        `LOCATION:${location}`,
        'END:VEVENT',
        'END:VCALENDAR',
      ].join('\r\n');
      const icsBlob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      (document.getElementById('cal-apple') as HTMLAnchorElement).href = URL.createObjectURL(icsBlob);

      hide('step-2');
      show('step-3');
    });
  </script>
</Layout>
